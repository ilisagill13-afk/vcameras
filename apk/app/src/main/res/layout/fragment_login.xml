<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Hero -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🇺🇸 🇨🇦"
            android:textSize="40sp"
            android:gravity="center"
            android:paddingTop="24dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="US Visa Bot"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="#111827"
            android:paddingTop="8dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Canada — AIS Appointment Scheduler"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#6B7280"
            android:paddingBottom="24dp"/>

        <!-- Connected state -->
        <LinearLayout
            android:id="@+id/connected_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_green_card"
            android:padding="16dp"
            android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="● Connected to AIS" android:textColor="#065f46"
                android:textStyle="bold" android:textSize="14sp"/>
            <TextView android:id="@+id/tv_connected_email"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#111827" android:textSize="15sp"
                android:paddingTop="4dp" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_appointment_id"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#6B7280" android:textSize="12sp" android:paddingBottom="12dp"/>
            <Button android:id="@+id/btn_disconnect"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Disconnect" android:backgroundTint="#E5E7EB"
                android:textColor="#374151" android:textSize="13sp"/>
        </LinearLayout>

        <!-- Form -->
        <LinearLayout
            android:id="@+id/form_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="18dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Connect AIS Account" android:textStyle="bold"
                android:textSize="16sp" android:textColor="#111827"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Enter your ais.usvisa-info.com credentials"
                android:textSize="13sp" android:textColor="#6B7280"
                android:paddingTop="4dp" android:paddingBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AIS EMAIL" android:textSize="11sp" android:textStyle="bold"
                android:textColor="#374151" android:paddingBottom="6dp"/>
            <EditText android:id="@+id/input_email"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:inputType="textEmailAddress" android:hint="your@email.com"
                android:background="@drawable/bg_input" android:padding="10dp"
                android:textSize="15sp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="AIS PASSWORD" android:textSize="11sp" android:textStyle="bold"
                android:textColor="#374151" android:paddingTop="14dp" android:paddingBottom="6dp"/>
            <EditText android:id="@+id/input_password"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:inputType="textPassword" android:hint="••••••••"
                android:background="@drawable/bg_input" android:padding="10dp"
                android:textSize="15sp"/>

            <TextView android:id="@+id/tv_error"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_error" android:padding="12dp"
                android:textColor="#DC2626" android:textSize="13sp"
                android:layout_marginTop="12dp" android:visibility="gone"/>

            <Button android:id="@+id/btn_connect"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:text="Connect to AIS Portal"
                android:backgroundTint="#1A56DB"
                android:textColor="@android:color/white"
                android:textStyle="bold" android:textSize="15sp"
                android:layout_marginTop="18dp"/>
        </LinearLayout>

        <!-- Info box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_info"
            android:padding="16dp"
            android:layout_marginTop="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="HOW IT WORKS" android:textSize="11sp" android:textStyle="bold"
                android:textColor="#1A56DB" android:paddingBottom="8dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="1. Connect your AIS account\n2. Check real-time slots\n3. Book with one tap — or Auto-Book\n4. Get notified when a slot opens"
                android:textSize="13sp" android:textColor="#374151" android:lineSpacingExtra="4dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
