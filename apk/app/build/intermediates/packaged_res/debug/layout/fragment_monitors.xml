<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F9FAFB">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Add Monitor" android:textStyle="bold"
                android:textSize="16sp" android:textColor="#111827"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Auto-checks every 15 minutes in background"
                android:textSize="13sp" android:textColor="#6B7280"
                android:paddingTop="4dp" android:paddingBottom="16dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CONSULATE" android:textSize="11sp" android:textStyle="bold"
                android:textColor="#374151" android:paddingBottom="6dp"/>
            <Spinner android:id="@+id/sp_city_mon"
                android:layout_width="match_parent" android:layout_height="44dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="VISA TYPE" android:textSize="11sp" android:textStyle="bold"
                android:textColor="#374151" android:paddingTop="14dp" android:paddingBottom="6dp"/>
            <Spinner android:id="@+id/sp_visa_mon"
                android:layout_width="match_parent" android:layout_height="44dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingTop="14dp"
                android:background="#F3F4F6" android:padding="14dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Auto-Book" android:textStyle="bold" android:textSize="14sp" android:textColor="#111827"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Book first available slot automatically"
                        android:textSize="12sp" android:textColor="#6B7280"/>
                </LinearLayout>
                <CheckBox android:id="@+id/cb_autobook"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <Button android:id="@+id/btn_add_monitor"
                android:layout_width="match_parent" android:layout_height="44dp"
                android:text="Add Monitor" android:backgroundTint="#1A56DB"
                android:textColor="@android:color/white" android:textStyle="bold"
                android:layout_marginTop="16dp"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="YOUR MONITORS" android:textSize="11sp" android:textStyle="bold"
            android:textColor="#374151" android:paddingTop="20dp" android:paddingBottom="10dp"/>

        <LinearLayout android:id="@+id/monitors_list"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </LinearLayout>
</ScrollView>
