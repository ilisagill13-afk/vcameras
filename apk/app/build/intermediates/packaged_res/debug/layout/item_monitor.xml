<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card"
    android:padding="16dp" android:layout_marginBottom="12dp">

    <TextView android:id="@+id/tv_mon_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textStyle="bold" android:textSize="14sp" android:textColor="#111827"/>
    <TextView android:id="@+id/tv_mon_meta"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#6B7280" android:paddingTop="4dp" android:paddingBottom="12dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/btn_mon_toggle"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Pause" android:backgroundTint="#E5E7EB"
            android:textColor="#374151" android:textSize="13sp" android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btn_mon_delete"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Remove" android:backgroundTint="#E02424"
            android:textColor="@android:color/white" android:textSize="13sp" android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btn_mon_run"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="36dp"
            android:text="Check Now" android:backgroundTint="#0EA472"
            android:textColor="@android:color/white" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
